# TxT Sanitizer V2 — Local Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── Feedback Email (Nodemailer) ───────────────────────────────────────────────
# Gmail address used as sender for feedback emails
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# To generate: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Single password for the /admin route (Phase 7)
ADMIN_PASSWORD=change-me-before-deploy
