# TxT Sanitizer V2 — Local Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── Email (Resend API) ────────────────────────────────────────────────────────
# Get a free API key at https://resend.com (100 emails/day free tier)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The inbox address that will receive feedback form submissions
FEEDBACK_EMAIL=your-email@example.com

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Single password for the /admin route
ADMIN_PASSWORD=change-me-before-deploy
